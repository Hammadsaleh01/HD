# PlateShare Application Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JSON Web Token Secret (Required in production; auto-generated in dev if missing)
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars-long

# AES-256-GCM Encryption Key for National CNIC PII at rest (32-byte hex or base64 key)
CNIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Allowed Origins (Comma-separated or '*' for dev)
CORS_ORIGINS=*

# Payment Gateway Execution Mode ('Simulated_Demonstration_Sandbox' | 'Live_Gateway')
PAYMENT_MODE=Simulated_Demonstration_Sandbox